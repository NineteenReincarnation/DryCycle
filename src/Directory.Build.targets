<Project>
  <!-- Optional RWImGui frontend projects live below src/, so the SDK-style DryCycle
       project would otherwise glob their source into DryCycle.dll. Keep ImGui-facing
       code in optional assemblies so the gameplay/core DLL never acquires an ImGui.NET
       dependency. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DryCycle'">
    <Compile Remove="DryCycle.AIObservatory.RWImGui/**/*.cs" />
    <Compile Remove="DevUI/DevTool/RWImGui/**/*.cs" />
    <Compile Remove="Debug/AIDebugger/Runtime/AIDebugDockingNative.cs" />
    <Compile Remove="Debug/AIDebugger/Runtime/AIDebugImGuiBackend.cs" />
    <Compile Remove="Debug/AIDebugger/Runtime/AIDebugImGuiIniIsolation.cs" />
    <Compile Remove="Debug/AIDebugger/Runtime/AIDebugStyleController.cs" />
    <Compile Remove="Debug/AIDebugger/UI/AIDebugAdvancedOverlay.cs" />
    <Compile Remove="Debug/AIDebugger/UI/AIDebugWorldOverlay.cs" />
    <Compile Remove="Debug/AIDebugger/UI/AIDebuggerWindowV3.cs" />
  </ItemGroup>

  <!-- Late-imported properties can safely use RainWorldDir from DryCycle.csproj. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DryCycle'">
    <BuildRWImGuiBridge Condition="'$(BuildRWImGuiBridge)' == ''">true</BuildRWImGuiBridge>
    <RWImGuiWorkshopRootPluginDir Condition="'$(RWImGuiWorkshopRootPluginDir)' == ''">$(RainWorldDir)/../../workshop/content/312520/3417372413/plugins</RWImGuiWorkshopRootPluginDir>
    <RWImGuiWorkshopPackagePluginDir Condition="'$(RWImGuiWorkshopPackagePluginDir)' == ''">$(RainWorldDir)/../../workshop/content/312520/3417372413/rwimgui/plugins</RWImGuiWorkshopPackagePluginDir>
    <RWImGuiLocalPluginDir Condition="'$(RWImGuiLocalPluginDir)' == ''">$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/rwimgui/plugins</RWImGuiLocalPluginDir>
    <ResolvedRWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' != '' and Exists('$(RWImGuiPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiPluginDir)</ResolvedRWImGuiPluginDir>
    <ResolvedRWImGuiPluginDir Condition="'$(ResolvedRWImGuiPluginDir)' == '' and Exists('$(RWImGuiWorkshopRootPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiWorkshopRootPluginDir)</ResolvedRWImGuiPluginDir>
    <ResolvedRWImGuiPluginDir Condition="'$(ResolvedRWImGuiPluginDir)' == '' and Exists('$(RWImGuiWorkshopPackagePluginDir)/rain-world-imgui-api.dll')">$(RWImGuiWorkshopPackagePluginDir)</ResolvedRWImGuiPluginDir>
    <ResolvedRWImGuiPluginDir Condition="'$(ResolvedRWImGuiPluginDir)' == '' and Exists('$(RWImGuiLocalPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiLocalPluginDir)</ResolvedRWImGuiPluginDir>
  </PropertyGroup>

  <!-- Visual Studio's fast up-to-date check only sees files that belong to the main
       project by default. RWImGui frontend sources are intentionally excluded from DryCycle.dll,
       so changing only those files previously let VS report "up to date" and skip MSBuild entirely.
       Explicit inputs/outputs make a frontend edit or missing frontend DLL invalidate DryCycle's
       local deploy build, allowing BuildOptionalRWImGuiBridge below to run its forced Rebuild. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'DryCycle' and '$(DeployToGame)' == 'true'">
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)/DevUI/DevTool/RWImGui/**/*.cs" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)/DevUI/DevTool/RWImGui/DryCycle.DevTool.RWImGui.csproj" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)/DryCycle.AIObservatory.RWImGui/**/*.cs" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)/DryCycle.AIObservatory.RWImGui/DryCycle.AIObservatory.RWImGui.csproj" />
    <UpToDateCheckBuilt Include="$(GameModOutputDir)/DryCycle.DevTool.RWImGui.dll" />
    <UpToDateCheckBuilt Include="$(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.dll" />
  </ItemGroup>

  <!-- During the RWImGUI migration DryCycle must not leave a second RWImGui API,
       ImGui.NET or cimgui runtime beside DryCycle.dll. RWImGUI ships a matched API + modified
       ImGui.NET/native stack and duplicate/private copies can make the CLR or native backend bind
       an incompatible version during startup. Compile-only validation must never mutate a game/mod
       installation. -->
  <Target Name="RemoveLegacyDryCycleImGuiRuntime"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'DryCycle' and '$(DeployToGame)' == 'true' and '$(GameModOutputDir)' != ''">
    <ItemGroup>
      <LegacyDryCycleImGuiRuntime Include="$(GameModOutputDir)/rain-world-imgui-api.dll" />
      <LegacyDryCycleImGuiRuntime Include="$(GameModOutputDir)/rain-world-imgui-api.pdb" />
      <LegacyDryCycleImGuiRuntime Include="$(GameModOutputDir)/ImGui.NET.dll" />
      <LegacyDryCycleImGuiRuntime Include="$(GameModOutputDir)/cimgui.dll" />
    </ItemGroup>
    <Delete Files="@(LegacyDryCycleImGuiRuntime)" />
    <Message Importance="high"
             Text="DryCycle RWImGUI migration: removed stale local RWImGui API/ImGui.NET/cimgui runtime copies from $(GameModOutputDir)." />
  </Target>

  <!-- Build optional frontends automatically when RWImGUI is installed. These assemblies are the
       actual runtime owners of the ImGui UI. Never allow an incremental/stale frontend DLL to
       survive a successful DryCycle deploy: delete it first, force Rebuild, and fail the parent
       build if the expected DLL was not produced. -->
  <Target Name="BuildOptionalRWImGuiBridge"
          AfterTargets="Build"
          DependsOnTargets="RemoveLegacyDryCycleImGuiRuntime;ILRepacker"
          Condition="'$(MSBuildProjectName)' == 'DryCycle' and '$(DeployToGame)' == 'true' and '$(BuildRWImGuiBridge)' == 'true' and '$(ResolvedRWImGuiPluginDir)' != ''">
    <ItemGroup>
      <PreviousRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.dll" />
      <PreviousRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.pdb" />
      <PreviousRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.DevTool.RWImGui.dll" />
      <PreviousRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.DevTool.RWImGui.pdb" />
    </ItemGroup>
    <Delete Files="@(PreviousRWImGuiBridge)" />
    <Message Importance="high"
             Text="DryCycle RWImGUI migration: cleared stale optional frontend outputs before forced rebuild." />

    <Message Importance="high"
             Text="DryCycle RWImGUI migration: restoring AI Observatory frontend against $(ResolvedRWImGuiPluginDir)." />
    <MSBuild Projects="$(MSBuildProjectDirectory)/DryCycle.AIObservatory.RWImGui/DryCycle.AIObservatory.RWImGui.csproj"
             Targets="Restore"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RainWorldDir=$(RainWorldDir);GameModOutputDir=$(GameModOutputDir);RWImGuiPluginDir=$(ResolvedRWImGuiPluginDir)" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/DryCycle.AIObservatory.RWImGui/DryCycle.AIObservatory.RWImGui.csproj"
             Targets="Rebuild"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RainWorldDir=$(RainWorldDir);GameModOutputDir=$(GameModOutputDir);RWImGuiPluginDir=$(ResolvedRWImGuiPluginDir)" />
    <Error Condition="!Exists('$(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.dll')"
           Text="DryCycle AI Observatory RWImGui frontend rebuild reported success but no DLL was deployed to $(GameModOutputDir)." />

    <Message Importance="high"
             Text="DryCycle RWImGUI migration: restoring DevTool frontend against $(ResolvedRWImGuiPluginDir)." />
    <MSBuild Projects="$(MSBuildProjectDirectory)/DevUI/DevTool/RWImGui/DryCycle.DevTool.RWImGui.csproj"
             Targets="Restore"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RainWorldDir=$(RainWorldDir);GameModOutputDir=$(GameModOutputDir);RWImGuiPluginDir=$(ResolvedRWImGuiPluginDir)" />
    <MSBuild Projects="$(MSBuildProjectDirectory)/DevUI/DevTool/RWImGui/DryCycle.DevTool.RWImGui.csproj"
             Targets="Rebuild"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RainWorldDir=$(RainWorldDir);GameModOutputDir=$(GameModOutputDir);RWImGuiPluginDir=$(ResolvedRWImGuiPluginDir)" />
    <Error Condition="!Exists('$(GameModOutputDir)/DryCycle.DevTool.RWImGui.dll')"
           Text="DryCycle DevTool RWImGui frontend rebuild reported success but no DLL was deployed to $(GameModOutputDir)." />

    <Message Importance="high"
             Text="DryCycle RWImGUI migration: AI Observatory frontend rebuilt and deployed to $(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.dll." />
    <Message Importance="high"
             Text="DryCycle RWImGUI migration: DevTool frontend rebuilt and deployed to $(GameModOutputDir)/DryCycle.DevTool.RWImGui.dll." />
  </Target>

  <Target Name="ReportMissingOptionalRWImGuiBridge"
          AfterTargets="Build"
          DependsOnTargets="RemoveLegacyDryCycleImGuiRuntime;ILRepacker"
          Condition="'$(MSBuildProjectName)' == 'DryCycle' and '$(DeployToGame)' == 'true' and '$(BuildRWImGuiBridge)' == 'true' and '$(ResolvedRWImGuiPluginDir)' == ''">
    <ItemGroup>
      <StaleRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.dll" />
      <StaleRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.AIObservatory.RWImGui.pdb" />
      <StaleRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.DevTool.RWImGui.dll" />
      <StaleRWImGuiBridge Include="$(GameModOutputDir)/DryCycle.DevTool.RWImGui.pdb" />
    </ItemGroup>
    <Delete Files="@(StaleRWImGuiBridge)" />
    <Message Importance="high"
             Text="DryCycle RWImGUI migration: RWImGUI not found; optional frontends were skipped and stale outputs removed. Install Workshop 3417372413 or pass -p:RWImGuiPluginDir=... to build them." />
  </Target>
</Project>
