<Project>
  <!-- Rain World on Windows is a 64-bit Unity player. Pinning x64 also lets
       ImGui.NET's net40 build target select and copy the matching cimgui.dll
       beside DryCycle.dll in the configured plugin output directory. -->
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- ImGuiIO exposes IniFilename as a native pointer. The Observatory disables
         Dear ImGui's default shared imgui.ini before first NewFrame and uses its own
         explicit UTF-8 layout file instead. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- DryCycle is a class library, but the mod plugin directory is also its runtime
         probing directory. Copy PackageReference runtime assets (ImGui.NET plus its
         netstandard support dependencies) beside DryCycle.dll instead of assuming the
         game already ships compatible versions. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
  </ItemGroup>
</Project>
