<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DryCycle</AssemblyName>
    <RootNamespace>DryCycle</RootNamespace>
    <Version>0.2.2</Version>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup>
    <LocalReferenceDir>$(MSBuildThisFileDirectory)../../lib</LocalReferenceDir>
    <RainWorldManagedDir Condition="'$(RainWorldPath)' != ''">$(RainWorldPath)/RainWorld_Data/Managed</RainWorldManagedDir>

    <PublicAssemblyPath Condition="Exists('$(LocalReferenceDir)/PUBLIC-Assembly-CSharp.dll')">$(LocalReferenceDir)/PUBLIC-Assembly-CSharp.dll</PublicAssemblyPath>
    <HooksAssemblyPath Condition="Exists('$(LocalReferenceDir)/HOOKS-Assembly-CSharp.dll')">$(LocalReferenceDir)/HOOKS-Assembly-CSharp.dll</HooksAssemblyPath>
    <FirstpassAssemblyPath Condition="Exists('$(LocalReferenceDir)/Assembly-CSharp-firstpass.dll')">$(LocalReferenceDir)/Assembly-CSharp-firstpass.dll</FirstpassAssemblyPath>
    <BepInExAssemblyPath Condition="Exists('$(LocalReferenceDir)/BepInEx.dll')">$(LocalReferenceDir)/BepInEx.dll</BepInExAssemblyPath>
    <UnityEngineAssemblyPath Condition="Exists('$(LocalReferenceDir)/UnityEngine.dll')">$(LocalReferenceDir)/UnityEngine.dll</UnityEngineAssemblyPath>
    <UnityCoreAssemblyPath Condition="Exists('$(LocalReferenceDir)/UnityEngine.CoreModule.dll')">$(LocalReferenceDir)/UnityEngine.CoreModule.dll</UnityCoreAssemblyPath>

    <PublicAssemblyPath Condition="'$(PublicAssemblyPath)' == '' and '$(RainWorldPath)' != ''">$(RainWorldPath)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</PublicAssemblyPath>
    <HooksAssemblyPath Condition="'$(HooksAssemblyPath)' == '' and '$(RainWorldPath)' != ''">$(RainWorldPath)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HooksAssemblyPath>
    <FirstpassAssemblyPath Condition="'$(FirstpassAssemblyPath)' == '' and '$(RainWorldManagedDir)' != ''">$(RainWorldManagedDir)/Assembly-CSharp-firstpass.dll</FirstpassAssemblyPath>
    <BepInExAssemblyPath Condition="'$(BepInExAssemblyPath)' == '' and '$(RainWorldPath)' != ''">$(RainWorldPath)/BepInEx/core/BepInEx.dll</BepInExAssemblyPath>
    <UnityEngineAssemblyPath Condition="'$(UnityEngineAssemblyPath)' == '' and '$(RainWorldManagedDir)' != ''">$(RainWorldManagedDir)/UnityEngine.dll</UnityEngineAssemblyPath>
    <UnityCoreAssemblyPath Condition="'$(UnityCoreAssemblyPath)' == '' and '$(RainWorldManagedDir)' != ''">$(RainWorldManagedDir)/UnityEngine.CoreModule.dll</UnityCoreAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PUBLIC-Assembly-CSharp" HintPath="$(PublicAssemblyPath)" Private="false" />
    <Reference Include="HOOKS-Assembly-CSharp" HintPath="$(HooksAssemblyPath)" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(FirstpassAssemblyPath)" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExAssemblyPath)" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(UnityEngineAssemblyPath)" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(UnityCoreAssemblyPath)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ModAssetFiles Include="$(MSBuildThisFileDirectory)../../mod/**/*" Exclude="$(MSBuildThisFileDirectory)../../mod/plugins/**/*" />
  </ItemGroup>

  <Target Name="ValidateRainWorldReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(PublicAssemblyPath)' == '' or !Exists('$(PublicAssemblyPath)')" Text="PUBLIC-Assembly-CSharp.dll was not found. Set RainWorldPath to the Rain World installation folder, or place it in ./lib." />
    <Error Condition="'$(HooksAssemblyPath)' == '' or !Exists('$(HooksAssemblyPath)')" Text="HOOKS-Assembly-CSharp.dll was not found. Set RainWorldPath to the Rain World installation folder, or place it in ./lib." />
    <Error Condition="'$(FirstpassAssemblyPath)' == '' or !Exists('$(FirstpassAssemblyPath)')" Text="Assembly-CSharp-firstpass.dll was not found. Set RainWorldPath to the Rain World installation folder, or place it in ./lib." />
    <Error Condition="'$(BepInExAssemblyPath)' == '' or !Exists('$(BepInExAssemblyPath)')" Text="BepInEx.dll was not found. Set RainWorldPath to the Rain World installation folder, or place it in ./lib." />
    <Error Condition="'$(UnityEngineAssemblyPath)' == '' or !Exists('$(UnityEngineAssemblyPath)')" Text="UnityEngine.dll was not found. Set RainWorldPath to the Rain World installation folder, or place it in ./lib." />
    <Error Condition="'$(UnityCoreAssemblyPath)' == '' or !Exists('$(UnityCoreAssemblyPath)')" Text="UnityEngine.CoreModule.dll was not found. Set RainWorldPath to the Rain World installation folder, or place it in ./lib." />
  </Target>

  <Target Name="BuildDryCycleModFolder" AfterTargets="Build">
    <PropertyGroup>
      <DryCycleModOutput>$(MSBuildThisFileDirectory)../../artifacts/DryCycle</DryCycleModOutput>
    </PropertyGroup>
    <RemoveDir Directories="$(DryCycleModOutput)" />
    <MakeDir Directories="$(DryCycleModOutput)/plugins" />
    <Copy SourceFiles="@(ModAssetFiles)" DestinationFiles="@(ModAssetFiles->'$(DryCycleModOutput)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DryCycleModOutput)/plugins" />
  </Target>
</Project>
