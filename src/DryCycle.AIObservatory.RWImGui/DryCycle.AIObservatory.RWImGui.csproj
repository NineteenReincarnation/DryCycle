<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DryCycle.AIObservatory.RWImGui</AssemblyName>
    <RootNamespace>DryCycle.AIObservatory.RWImGui</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GameModOutputDir Condition="'$(GameModOutputDir)' == ''">D:/Application/Steam/steamapps/common/Rain World/RainWorld_Data/StreamingAssets/mods/Ancient Site/newest/plugins</GameModOutputDir>
    <OutputPath>$(GameModOutputDir)</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <RainWorldDir Condition="'$(RainWorldDir)' == '' and '$(RainWorldPath)' != ''">$(RainWorldPath)</RainWorldDir>
    <RainWorldDir Condition="'$(RainWorldDir)' == '' and Exists('D:/Application/Steam/steamapps/common/Rain World')">D:/Application/Steam/steamapps/common/Rain World</RainWorldDir>

    <!-- Steam Workshop installs often expose the published mod root directly as the item
         directory, while release ZIPs contain a nested rwimgui/ folder. Support both. -->
    <RWImGuiWorkshopRootPluginDir>$(RainWorldDir)/../../workshop/content/312520/3417372413/plugins</RWImGuiWorkshopRootPluginDir>
    <RWImGuiWorkshopPackagePluginDir>$(RainWorldDir)/../../workshop/content/312520/3417372413/rwimgui/plugins</RWImGuiWorkshopPackagePluginDir>
    <RWImGuiLocalPluginDir>$(RainWorldDir)/RainWorld_Data/StreamingAssets/mods/rwimgui/plugins</RWImGuiLocalPluginDir>

    <RWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' == '' and Exists('$(RWImGuiWorkshopRootPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiWorkshopRootPluginDir)</RWImGuiPluginDir>
    <RWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' == '' and Exists('$(RWImGuiWorkshopPackagePluginDir)/rain-world-imgui-api.dll')">$(RWImGuiWorkshopPackagePluginDir)</RWImGuiPluginDir>
    <RWImGuiPluginDir Condition="'$(RWImGuiPluginDir)' == '' and Exists('$(RWImGuiLocalPluginDir)/rain-world-imgui-api.dll')">$(RWImGuiLocalPluginDir)</RWImGuiPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The normal DryCycle build runs first and places DryCycle.dll in GameModOutputDir.
         Referencing that deployed assembly avoids a project-reference recursion when the
         main project conditionally invokes this optional bridge after its own Build. -->
    <Reference Include="DryCycle">
      <HintPath>$(GameModOutputDir)/DryCycle.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(RainWorldDir)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PUBLIC-Assembly-CSharp">
      <HintPath>$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- IMPORTANT: compile ImGui widget calls against the modified ImGui.NET assembly
         shipped by RWImGUI itself. The API assembly is intentionally NOT a compile-time
         reference anymore: BridgePlugin discovers AddMenuCallback from the loaded
         rain-world-imgui-api assembly at runtime, so namespace/type moves in RWImGUI do
         not break DryCycle's build. -->
    <Reference Include="ImGui.NET">
      <HintPath>$(RWImGuiPluginDir)/ImGui.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRWImGuiBridgeReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RainWorldDir)' == ''" Text="RainWorldDir is not set for DryCycle.AIObservatory.RWImGui." />
    <Error Condition="!Exists('$(GameModOutputDir)/DryCycle.dll')" Text="DryCycle.dll must be built before DryCycle.AIObservatory.RWImGui. Expected $(GameModOutputDir)/DryCycle.dll." />
    <Error Condition="'$(RWImGuiPluginDir)' == ''" Text="RWImGUI was not found. Install Steam Workshop item 3417372413 or pass -p:RWImGuiPluginDir=&quot;.../plugins&quot;. The normal DryCycle project does not require this bridge." />
    <Error Condition="!Exists('$(RWImGuiPluginDir)/rain-world-imgui-api.dll')" Text="rain-world-imgui-api.dll not found under $(RWImGuiPluginDir)." />
    <Error Condition="!Exists('$(RWImGuiPluginDir)/ImGui.NET.dll')" Text="RWImGUI modified ImGui.NET.dll not found under $(RWImGuiPluginDir). Do not substitute the NuGet version." />
    <Error Condition="!Exists('$(RainWorldDir)/BepInEx/core/BepInEx.dll')" Text="BepInEx.dll not found under $(RainWorldDir)/BepInEx/core." />
  </Target>
</Project>
