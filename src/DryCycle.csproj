<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DryCycle</AssemblyName>
    <RootNamespace>DryCycle</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameModOutputDir>D:/Application/Steam/steamapps/common/Rain World/RainWorld_Data/StreamingAssets/mods/Ancient Site/newest/plugins</GameModOutputDir>
    <GameModRootDir>$(GameModOutputDir)/../..</GameModRootDir>
    <OutputPath>$(GameModOutputDir)</OutputPath>
    <PathMap>$(MSBuildProjectDirectory)=/DryCycle</PathMap>
  </PropertyGroup>

  <!-- RainWorldDir can be supplied as an environment variable or MSBuild property.
       The second line is a convenience fallback for the current development machine. -->
  <PropertyGroup>
    <RainWorldDir Condition="'$(RainWorldDir)' == '' and '$(RainWorldPath)' != ''">$(RainWorldPath)</RainWorldDir>
    <RainWorldDir Condition="'$(RainWorldDir)' == '' and Exists('D:/Application/Steam/steamapps/common/Rain World')">D:/Application/Steam/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only reference the assemblies DryCycle actually needs. SlugBase support
         is reflection-based and therefore remains an optional runtime integration. -->
    <Reference Include="BepInEx">
      <HintPath>$(RainWorldDir)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PUBLIC-Assembly-CSharp">
      <HintPath>$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HOOKS-Assembly-CSharp">
      <HintPath>$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(RainWorldDir)/RainWorld_Data/Managed/Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ValidateRainWorldDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RainWorldDir)' == ''" Text="RainWorldDir is not set. Pass -p:RainWorldDir=&quot;D:/Application/Steam/steamapps/common/Rain World&quot; or set the RainWorldDir environment variable." />
    <Error Condition="!Exists('$(RainWorldDir)/BepInEx/core/BepInEx.dll')" Text="BepInEx.dll not found under $(RainWorldDir)/BepInEx/core." />
    <Error Condition="!Exists('$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll')" Text="PUBLIC-Assembly-CSharp.dll not found under $(RainWorldDir)/BepInEx/utils." />
    <Error Condition="!Exists('$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll')" Text="HOOKS-Assembly-CSharp.dll not found under $(RainWorldDir)/BepInEx/plugins." />
    <Error Condition="!Exists('$(RainWorldDir)/RainWorld_Data/Managed/Assembly-CSharp-firstpass.dll')" Text="Assembly-CSharp-firstpass.dll not found under $(RainWorldDir)/RainWorld_Data/Managed." />
    <Error Condition="!Exists('$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll')" Text="UnityEngine.dll not found under $(RainWorldDir)/RainWorld_Data/Managed." />
    <Error Condition="!Exists('$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll not found under $(RainWorldDir)/RainWorld_Data/Managed." />
    <Error Condition="!Exists('$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.InputLegacyModule.dll')" Text="UnityEngine.InputLegacyModule.dll not found under $(RainWorldDir)/RainWorld_Data/Managed." />
    <Error Condition="!Exists('$(RainWorldDir)/RainWorld_Data/Managed/Unity.Mathematics.dll')" Text="Unity.Mathematics.dll not found under $(RainWorldDir)/RainWorld_Data/Managed." />
    <Error Condition="!Exists('$(GameModOutputDir)')" Text="DryCycle output folder not found: $(GameModOutputDir)" />
  </Target>

  <Target Name="GenerateMod" AfterTargets="PostBuildEvent" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <ItemGroup>
      <RemovePlugins Include="$(GameModOutputDir)/*.pdb" />
    </ItemGroup>

    <Delete Files="@(RemovePlugins)" />

    <!-- Rain World's custom SoundID data is merged from the mod root's
         modify/soundeffects/sounds.txt. Keep the authored OGG itself in
         Ancient Site/soundeffects/DC_DrinkWater.ogg. -->
    <MakeDir Directories="$(GameModRootDir)/modify/soundeffects" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/../mod/modify/soundeffects/sounds.txt"
      DestinationFiles="$(GameModRootDir)/modify/soundeffects/sounds.txt"
      SkipUnchangedFiles="true" />

    <!-- These world text files are live-authored in the actual region mod. Seed them
         only when missing; never overwrite mapper/weather tuning during a build. -->
    <MakeDir Directories="$(GameModRootDir)/world" />
    <Copy
      Condition="!Exists('$(GameModRootDir)/world/TemperatureSets.txt')"
      SourceFiles="$(MSBuildProjectDirectory)/../mod/world/TemperatureSets.txt"
      DestinationFiles="$(GameModRootDir)/world/TemperatureSets.txt" />
    <Copy
      Condition="!Exists('$(GameModRootDir)/world/RegionClimate.txt')"
      SourceFiles="$(MSBuildProjectDirectory)/../mod/world/RegionClimate.txt"
      DestinationFiles="$(GameModRootDir)/world/RegionClimate.txt" />

    <Warning
      Condition="!Exists('$(GameModRootDir)/soundeffects/DC_DrinkWater.ogg')"
      Text="Dew Pod drinking SFX not found: $(GameModRootDir)/soundeffects/DC_DrinkWater.ogg" />
  </Target>

</Project>
