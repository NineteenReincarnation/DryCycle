#!/bin/sh
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
remote_name="$1"

is_zero_oid() {
    case "$1" in
        *[!0]*) return 1 ;;
        "") return 1 ;;
        *) return 0 ;;
    esac
}

run_check() {
    base="$1"
    head="$2"

    if command -v pwsh >/dev/null 2>&1; then
        pwsh -NoProfile -File "$root/scripts/CodeMap.ps1" -Source Range -Base "$base" -Head "$head" -Repository "$root"
        return $?
    fi

    if command -v powershell.exe >/dev/null 2>&1; then
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/CodeMap.ps1" -Source Range -Base "$base" -Head "$head" -Repository "$root"
        return $?
    fi

    printf '%s\n' 'codemap: PowerShell unavailable' >&2
    return 30
}

while read local_ref local_oid remote_ref remote_oid
do
    if is_zero_oid "$local_oid"; then
        continue
    fi

    base="$remote_oid"
    if is_zero_oid "$remote_oid"; then
        base=""
        remote_main="refs/remotes/$remote_name/main"
        if git show-ref --verify --quiet "$remote_main"; then
            base=$(git merge-base "$local_oid" "$remote_main" 2>/dev/null || true)
        fi

        if [ "$base" = "$local_oid" ]; then
            continue
        fi

        if [ -z "$base" ]; then
            base="EMPTY"
        fi
    fi

    run_check "$base" "$local_oid"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        exit "$rc"
    fi
done

exit 0
