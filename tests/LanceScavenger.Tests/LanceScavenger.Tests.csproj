<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>13</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RainWorldDir Condition="'$(RainWorldDir)' == ''">D:/Steam/steamapps/common/Rain World</RainWorldDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DryCycle.csproj" AdditionalProperties="DeployToGame=false;BuildRWImGuiBridge=false" />
    <Compile Include="../IteratorFramework.Tests/RuntimeScene.cs" Link="RuntimeScene.cs" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PUBLIC-Assembly-CSharp"><HintPath>$(RainWorldDir)/BepInEx/utils/PUBLIC-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HOOKS-Assembly-CSharp"><HintPath>$(RainWorldDir)/BepInEx/plugins/HOOKS-Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(RainWorldDir)/RainWorld_Data/Managed/Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(RainWorldDir)/BepInEx/core/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
