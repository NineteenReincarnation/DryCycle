#pragma kernel GenerateFogNoise

RWTexture3D<float4> _NoiseVolume;
int _VolumeSize;

float Hash11(float n)
{
    return frac(sin(n) * 43758.5453123);
}

int WrapCell(int value, int period)
{
    int wrapped = value % period;
    return wrapped < 0 ? wrapped + period : wrapped;
}

int3 WrapCell3(int3 value, int period)
{
    return int3(
        WrapCell(value.x, period),
        WrapCell(value.y, period),
        WrapCell(value.z, period));
}

float HashPeriodic(int3 cell, int period)
{
    int3 wrapped = WrapCell3(cell, period);
    return Hash11(
        wrapped.x * 1.0 +
        wrapped.y * 57.0 +
        wrapped.z * 113.0 +
        period * 17.0);
}

float3 Hash33Periodic(int3 cell, int period)
{
    int3 wrapped = WrapCell3(cell, period);
    float3 p = float3(wrapped);
    p = frac(p * float3(0.1031, 0.1030, 0.0973) + period * 0.017);
    p += dot(p, p.yxz + 33.33);
    return frac((p.xxy + p.yxx) * p.zyx);
}

float PeriodicValueNoise(float3 p, int period)
{
    int3 cell = int3(floor(p));
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    float n000 = HashPeriodic(cell + int3(0, 0, 0), period);
    float n100 = HashPeriodic(cell + int3(1, 0, 0), period);
    float n010 = HashPeriodic(cell + int3(0, 1, 0), period);
    float n110 = HashPeriodic(cell + int3(1, 1, 0), period);
    float n001 = HashPeriodic(cell + int3(0, 0, 1), period);
    float n101 = HashPeriodic(cell + int3(1, 0, 1), period);
    float n011 = HashPeriodic(cell + int3(0, 1, 1), period);
    float n111 = HashPeriodic(cell + int3(1, 1, 1), period);

    float x00 = lerp(n000, n100, f.x);
    float x10 = lerp(n010, n110, f.x);
    float x01 = lerp(n001, n101, f.x);
    float x11 = lerp(n011, n111, f.x);
    float y0 = lerp(x00, x10, f.y);
    float y1 = lerp(x01, x11, f.y);
    return lerp(y0, y1, f.z);
}

float PeriodicFBM(float3 uv, int basePeriod)
{
    float value = 0.0;
    float amplitude = 0.5333333;
    float normalization = 0.0;
    int period = basePeriod;

    [unroll]
    for (int octave = 0; octave < 4; octave++)
    {
        float3 p = uv * (float)period;
        value += PeriodicValueNoise(p, period) * amplitude;
        normalization += amplitude;
        amplitude *= 0.5;
        period *= 2;
    }

    return saturate(value / max(normalization, 0.0001));
}

float PeriodicWorleyF1(float3 uv, int period)
{
    float3 p = uv * (float)period;
    int3 baseCell = int3(floor(p));
    float3 local = frac(p);
    float minDistanceSquared = 8.0;

    [unroll]
    for (int z = -1; z <= 1; z++)
    {
        [unroll]
        for (int y = -1; y <= 1; y++)
        {
            [unroll]
            for (int x = -1; x <= 1; x++)
            {
                int3 offset = int3(x, y, z);
                float3 feature = Hash33Periodic(baseCell + offset, period);
                float3 delta = float3(offset) + feature - local;
                minDistanceSquared = min(
                    minDistanceSquared,
                    dot(delta, delta));
            }
        }
    }

    return saturate(sqrt(minDistanceSquared) / 1.7320508);
}

[numthreads(4, 4, 4)]
void GenerateFogNoise(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _VolumeSize ||
        id.y >= _VolumeSize ||
        id.z >= _VolumeSize)
    {
        return;
    }

    float3 uv = (float3(id) + 0.5) / (float)_VolumeSize;

    // Every component below is explicitly periodic in [0,1]^3. Trilinear Repeat
    // sampling therefore crosses volume boundaries without the seam produced by the
    // previous non-periodic FBM implementation.
    float fbmLow = PeriodicFBM(uv, 4);
    // 6,12,24,48 stays within the Nyquist limit of the runtime 96^3 volume.
    float fbmHigh = PeriodicFBM(
        frac(uv + float3(0.173, 0.391, 0.617)),
        6);
    float worleyLow = PeriodicWorleyF1(
        frac(uv + float3(0.271, 0.113, 0.443)),
        5);
    float worleyHigh = PeriodicWorleyF1(
        frac(uv + float3(0.619, 0.347, 0.191)),
        13);

    // Nubis-style authoring principle: coherent FBM supplies the cloud body; cellular
    // fields erode its boundary instead of merely multiplying independent textures.
    float macro = saturate(
        fbmLow * 1.22 -
        worleyLow * 0.40 +
        0.17);
    float erosion = saturate(1.0 - worleyHigh);
    float detail = saturate(
        fbmHigh * 0.56 +
        erosion * 0.44);
    float hybrid = saturate(
        macro -
        (1.0 - detail) * 0.25);

    _NoiseVolume[id] = float4(
        hybrid,
        saturate(1.0 - worleyLow),
        detail,
        saturate(1.0 - worleyHigh));
}
