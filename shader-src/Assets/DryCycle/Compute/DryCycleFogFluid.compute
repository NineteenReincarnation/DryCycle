#pragma kernel InitializeFields
#pragma kernel AdvectVelocity
#pragma kernel ApplyForces
#pragma kernel ComputeCurl
#pragma kernel ApplyVorticity
#pragma kernel ComputeDivergence
#pragma kernel JacobiPressure
#pragma kernel ProjectVelocity
#pragma kernel ApplyBlastVelocity
#pragma kernel AdvectDensity
#pragma kernel MaintainDensity
#pragma kernel ApplyBlastDensity

Texture2D<float4> _VelocityRead;
RWTexture2D<float4> _VelocityWrite;
Texture2D<float4> _DensityRead;
RWTexture2D<float4> _DensityWrite;
Texture2D<float4> _PressureRead;
RWTexture2D<float4> _PressureWrite;
Texture2D<float4> _DivergenceRead;
RWTexture2D<float4> _DivergenceWrite;
Texture2D<float4> _CurlRead;
RWTexture2D<float4> _CurlWrite;
Texture2D<float4> _ObstacleTex;

SamplerState LinearClampSampler
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Clamp;
    AddressV = Clamp;
};

float _DeltaTime;
float _SimulationTime;
float _TargetDensity;
float _VelocityDissipation;
float _DensityDissipation;
float _DensityRelaxation;
float _VorticityStrength;
float _BlastClearDecay;
float4 _WindVelocity;
float4 _RoomSizePx;
int _ImpulseCount;
float4 _ImpulsePosRadius[4];
float4 _ImpulseVelocity[4];
int _BlastCount;
float4 _BlastPosRadii[4];
float4 _BlastParams[4];

static const float BlastWaveDistanceScale = 1024.0;
static const float BlastWaveLifetime = 0.62;
static const float TwoPi = 6.2831853;

float2 GridUV(uint2 id, uint width, uint height)
{
    return (float2(id) + 0.5) / float2(width, height);
}

float ObstacleAt(float2 uv)
{
    uint width;
    uint height;
    _ObstacleTex.GetDimensions(width, height);
    int2 p = int2(clamp(uv, 0.0, 0.999999) * float2(width, height));
    p = clamp(p, int2(0, 0), int2((int)width - 1, (int)height - 1));
    return _ObstacleTex.Load(int3(p, 0)).r;
}

float WallDistance01(float2 uv)
{
    uint width;
    uint height;
    _ObstacleTex.GetDimensions(width, height);
    int2 p = int2(clamp(uv, 0.0, 0.999999) * float2(width, height));
    p = clamp(p, int2(0, 0), int2((int)width - 1, (int)height - 1));
    return _ObstacleTex.Load(int3(p, 0)).g;
}

float4 LoadClamped(Texture2D<float4> tex, int2 p, uint width, uint height)
{
    p = clamp(p, int2(0, 0), int2((int)width - 1, (int)height - 1));
    return tex.Load(int3(p, 0));
}

float SmoothFalloff(float distancePx, float radiusPx)
{
    float x = saturate(1.0 - distancePx / max(1.0, radiusPx));
    x = x * x * (3.0 - 2.0 * x);
    return x;
}

float BlastShapeRadiusScale(float2 deltaPx, float2 blastUv)
{
    float angle = atan2(deltaPx.y, deltaPx.x);
    float seed = frac(
        blastUv.x * 37.17 +
        blastUv.y * 91.73) * TwoPi;

    float irregular =
        sin(angle * 2.0 + seed * 0.73) * 0.035 +
        sin(angle * 3.0 + seed) * 0.085 +
        sin(angle * 5.0 - seed * 1.41) * 0.050;
    return clamp(1.0 + irregular, 0.84, 1.16);
}

float BlastWaveRadiusPx(float ageSeconds)
{
    float age = max(0.0, ageSeconds);
    return (1250.0 * age) / (1.0 + age * 0.85);
}

float TargetShape(float2 uv, float time)
{
    float a = sin((uv.y * 2.31 + time * 0.010) * TwoPi);
    float b = sin((uv.y * -4.17 + uv.x * 0.73 + time * 0.006 + 0.31) * TwoPi);
    float c = sin((uv.y * 7.09 + time * -0.003 + 0.73) * TwoPi);
    return saturate(0.60 + a * 0.18 + b * 0.12 + c * 0.07);
}

float2 WallTangent(float2 uv, float2 texel)
{
    float left = WallDistance01(uv - float2(texel.x, 0.0));
    float right = WallDistance01(uv + float2(texel.x, 0.0));
    float bottom = WallDistance01(uv - float2(0.0, texel.y));
    float top = WallDistance01(uv + float2(0.0, texel.y));
    float2 gradient = float2(right - left, top - bottom);
    float len = length(gradient);
    if (len < 0.0001)
        return 0.0.xx;
    gradient /= len;
    return float2(-gradient.y, gradient.x);
}

// Deterministic scalar hash. Room dimensions are intentionally part of the seed below;
// the obstacle-aware solver then makes rooms with similar dimensions diverge further as
// the same atmosphere is projected around their different geometry.
float Hash11(float n)
{
    return frac(sin(n * 12.9898 + 78.233) * 43758.5453);
}

// Analytic 2D curl mode derived from a scalar stream function. Because velocity is
// (dPsi/dy, -dPsi/dx), each mode is divergence-free before pressure projection. This
// gives the background atmosphere broad circulation without procedural sinks/sources.
float2 CurlModePx(
    float2 worldPx,
    float2 wavelengthPx,
    float2 phase,
    float speedPxPerSecond)
{
    float2 wavelength = max(wavelengthPx, float2(64.0, 64.0));
    float2 k = TwoPi / wavelength;
    float2 a = worldPx * k + phase;
    float kReference = max(k.x, k.y);

    return speedPxPerSecond * float2(
        (k.y / kReference) * sin(a.x) * cos(a.y),
        -(k.x / kReference) * cos(a.x) * sin(a.y));
}

float AmbientIntermittency()
{
    float2 roomPx = max(_RoomSizePx.xy, float2(1.0, 1.0));
    float roomSeed = Hash11(
        roomPx.x * 0.0137 +
        roomPx.y * 0.0291 +
        17.31);

    float slow = 0.5 + 0.5 * sin(
        _SimulationTime * 0.029 +
        Hash11(roomSeed * 41.7 + 0.31) * TwoPi);
    float medium = 0.5 + 0.5 * sin(
        _SimulationTime * 0.071 +
        Hash11(roomSeed * 19.3 + 0.77) * TwoPi);

    float breathing = saturate(
        0.32 +
        slow * 0.22 +
        medium * 0.46);
    return breathing * breathing * (3.0 - 2.0 * breathing);
}

float2 AmbientTargetVelocityUv(float2 uv, float2 cellUv)
{
    float2 roomPx = max(_RoomSizePx.xy, float2(1.0, 1.0));
    float2 worldPx = uv * roomPx;
    float shortSide = max(120.0, min(roomPx.x, roomPx.y));
    float roomSeed = Hash11(
        roomPx.x * 0.0137 +
        roomPx.y * 0.0291 +
        17.31);
    float breathing = AmbientIntermittency();

    float2 macroPhase = TwoPi * float2(
        Hash11(roomSeed * 17.17 + 0.11),
        Hash11(roomSeed * 53.31 + 0.73));
    macroPhase += _SimulationTime * float2(0.011, -0.008);

    float2 mesoPhaseA = TwoPi * float2(
        Hash11(roomSeed * 71.3 + 0.29),
        Hash11(roomSeed * 31.9 + 0.61));
    mesoPhaseA += _SimulationTime * float2(-0.024, 0.019);

    float2 mesoPhaseB = TwoPi * float2(
        Hash11(roomSeed * 11.1 + 0.47),
        Hash11(roomSeed * 89.7 + 0.13));
    mesoPhaseB += _SimulationTime * float2(0.037, 0.028);

    float2 finePhase = TwoPi * float2(
        Hash11(roomSeed * 43.9 + 0.83),
        Hash11(roomSeed * 67.1 + 0.37));
    finePhase += _SimulationTime * float2(-0.052, 0.044);

    float2 macroWave = max(
        roomPx * float2(1.14, 1.08),
        float2(560.0, 440.0));
    float mesoScaleA = clamp(shortSide * 0.66, 300.0, 520.0);
    float mesoScaleB = clamp(shortSide * 0.43, 180.0, 330.0);
    float fineScale = clamp(shortSide * 0.22, 96.0, 168.0);

    float slowPulse = 0.5 + 0.5 * sin(
        _SimulationTime * 0.041 +
        roomSeed * TwoPi * 1.7);

    float2 macroPx = CurlModePx(
        worldPx,
        macroWave,
        macroPhase,
        7.4 * lerp(0.78, 1.08, slowPulse));
    float2 mesoPxA = CurlModePx(
        worldPx,
        mesoScaleA.xx,
        mesoPhaseA,
        4.8 * lerp(0.55, 1.0, breathing));
    float2 mesoPxB = CurlModePx(
        worldPx,
        mesoScaleB.xx,
        mesoPhaseB,
        2.6 * lerp(0.48, 1.0, breathing));
    float2 finePx = CurlModePx(
        worldPx,
        fineScale.xx,
        finePhase,
        0.82 * lerp(0.42, 1.0, breathing));

    // A very weak open-space vertical circulation stands in for slow thermal tendency.
    // It is x-dependent rather than y-dependent, so it is divergence-free in 2D and
    // cannot create fog from a point source. Pressure/obstacles reshape it afterwards.
    float convectionScale = max(380.0, shortSide * 0.92);
    float convectionPhase =
        worldPx.x / convectionScale * TwoPi +
        Hash11(roomSeed * 97.3 + 0.21) * TwoPi +
        _SimulationTime * 0.013;
    float convectionBreath = 0.5 + 0.5 * sin(
        _SimulationTime * 0.033 +
        Hash11(roomSeed * 23.7 + 0.66) * TwoPi);
    float openSpace = smoothstep(
        0.16,
        0.78,
        WallDistance01(uv));

    float2 ambientPx =
        macroPx +
        mesoPxA +
        mesoPxB +
        finePx;
    ambientPx.y +=
        sin(convectionPhase) *
        1.25 *
        lerp(0.42, 1.0, convectionBreath) *
        openSpace;

    // The old 22px/s prevailing drift is kept only as a weak large-scale bias. The
    // atmosphere above supplies most local motion; this prevents a room from looking like
    // one texture sheet scrolling permanently from left to right.
    float2 desiredVelocity =
        _WindVelocity.xy * 0.34 +
        ambientPx / roomPx;

    // Near geometry, pre-align the background field to the wall tangent. The following
    // pressure projection remains authoritative; this simply avoids constantly forcing
    // velocity straight into a wall and lets long-lived boundary currents emerge.
    float wallProximity = pow(
        saturate(1.0 - WallDistance01(uv)),
        1.85);
    float2 tangent = WallTangent(uv, cellUv);
    if (dot(tangent, tangent) > 0.25)
    {
        float2 tangentialVelocity =
            tangent * dot(desiredVelocity, tangent);
        desiredVelocity = lerp(
            desiredVelocity,
            tangentialVelocity,
            wallProximity * 0.88);

        float boundaryBreath = sin(
            uv.x * 2.7 +
            uv.y * 3.9 +
            _SimulationTime * 0.021 +
            roomSeed * TwoPi);
        desiredVelocity +=
            tangent * boundaryBreath * wallProximity *
            (0.55 / roomPx);
    }

    return desiredVelocity;
}

float BlastTerrainTransmission(
    float2 fromPx,
    float2 toPx,
    float receiverSolid)
{
    float rayLength = distance(fromPx, toPx);
    if (rayLength <= 1.0)
        return 1.0;

    const int BlastOcclusionSteps = 24;
    [loop]
    for (int i = 1; i <= BlastOcclusionSteps; i++)
    {
        float t = i / (float)(BlastOcclusionSteps + 1);
        float travelledPx = rayLength * t;
        float remainingPx = rayLength - travelledPx;
        if (travelledPx < 12.0)
            continue;
        if (receiverSolid > 0.5 && remainingPx < 16.0)
            continue;

        float2 p = lerp(fromPx, toPx, t);
        float2 uv = p / max(_RoomSizePx.xy, float2(1.0, 1.0));
        if (ObstacleAt(uv) > 0.5)
            return 0.0;
    }

    return 1.0;
}

float BlastClearNeighbourhood(int2 p, uint width, uint height)
{
    float clear = LoadClamped(_DensityRead, p, width, height).g * 0.22;

    clear += LoadClamped(_DensityRead, p + int2(1, 0), width, height).g * 0.10;
    clear += LoadClamped(_DensityRead, p + int2(-1, 0), width, height).g * 0.10;
    clear += LoadClamped(_DensityRead, p + int2(0, 1), width, height).g * 0.10;
    clear += LoadClamped(_DensityRead, p + int2(0, -1), width, height).g * 0.10;

    clear += LoadClamped(_DensityRead, p + int2(1, 1), width, height).g * 0.055;
    clear += LoadClamped(_DensityRead, p + int2(-1, 1), width, height).g * 0.055;
    clear += LoadClamped(_DensityRead, p + int2(1, -1), width, height).g * 0.055;
    clear += LoadClamped(_DensityRead, p + int2(-1, -1), width, height).g * 0.055;

    clear += LoadClamped(_DensityRead, p + int2(2, 0), width, height).g * 0.04;
    clear += LoadClamped(_DensityRead, p + int2(-2, 0), width, height).g * 0.04;
    clear += LoadClamped(_DensityRead, p + int2(0, 2), width, height).g * 0.04;
    clear += LoadClamped(_DensityRead, p + int2(0, -2), width, height).g * 0.04;

    return saturate(clear);
}

float DiffuseBlastClear(
    int2 p,
    uint width,
    uint height,
    float sourceClear,
    float ratePerSecond)
{
    float clearDecay = exp(-max(0.0, _BlastClearDecay) * _DeltaTime);
    float neighbourhood =
        BlastClearNeighbourhood(p, width, height) * clearDecay;
    float blend = 1.0 - exp(-max(0.0, ratePerSecond) * _DeltaTime);
    return saturate(lerp(sourceClear, neighbourhood, blend));
}

[numthreads(8, 8, 1)]
void InitializeFields(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _VelocityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    float2 uv = GridUV(id, width, height);
    bool solid = ObstacleAt(uv) > 0.5;

    float initialShape = TargetShape(uv, 0.0);
    float density = solid
        ? 0.0
        : _TargetDensity * lerp(0.48, 1.08, initialShape);
    float2 cellUv = 1.0 / float2(width, height);
    float2 initialVelocity = solid
        ? 0.0.xx
        : AmbientTargetVelocityUv(uv, cellUv);

    _VelocityWrite[id] = float4(
        initialVelocity,
        0.0,
        0.0);
    _DensityWrite[id] = float4(density, 0.0, 0.0, 0.0);
    _PressureWrite[id] = 0.0;
    _DivergenceWrite[id] = 0.0;
    _CurlWrite[id] = 0.0;
}

[numthreads(8, 8, 1)]
void AdvectVelocity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _VelocityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    float2 uv = GridUV(id, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _VelocityWrite[id] = 0.0;
        return;
    }

    float2 velocity = _VelocityRead.Load(int3(id, 0)).xy;
    float2 backtrace = clamp(uv - velocity * _DeltaTime, 0.0, 1.0);
    if (ObstacleAt(backtrace) > 0.5)
        backtrace = uv;

    float2 advected = _VelocityRead.SampleLevel(
        LinearClampSampler,
        backtrace,
        0).xy;
    _VelocityWrite[id] = float4(
        advected * _VelocityDissipation,
        0.0,
        0.0);
}

[numthreads(8, 8, 1)]
void ApplyForces(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _VelocityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    float2 uv = GridUV(id, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _VelocityWrite[id] = 0.0;
        return;
    }

    float2 velocity = _VelocityRead.Load(int3(id, 0)).xy;
    float2 cellUv = 1.0 / float2(width, height);

    // Ambient atmosphere is a weak target velocity, not a density animation. The force
    // response is deliberately slow so player wakes and explosions remain much stronger.
    float2 ambientTarget = AmbientTargetVelocityUv(uv, cellUv);
    float breathing = AmbientIntermittency();
    float atmosphereResponse = lerp(0.16, 0.32, breathing);
    float atmosphereBlend =
        1.0 - exp(-atmosphereResponse * _DeltaTime);
    velocity = lerp(
        velocity,
        ambientTarget,
        atmosphereBlend);

    float2 worldPx = uv * _RoomSizePx.xy;
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        if (i >= _ImpulseCount)
            break;

        float4 impulse = _ImpulsePosRadius[i];
        float2 impulsePx = impulse.xy * _RoomSizePx.xy;
        float falloff = SmoothFalloff(
            distance(worldPx, impulsePx),
            impulse.z) * impulse.w;
        velocity += _ImpulseVelocity[i].xy * falloff * 0.62;
    }

    _VelocityWrite[id] = float4(velocity, 0.0, 0.0);
}

[numthreads(8, 8, 1)]
void ComputeCurl(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _CurlWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    int2 p = int2(dispatchId.xy);
    float2 uv = GridUV(dispatchId.xy, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _CurlWrite[dispatchId.xy] = 0.0;
        return;
    }

    float2 left = LoadClamped(
        _VelocityRead,
        p + int2(-1, 0),
        width,
        height).xy;
    float2 right = LoadClamped(
        _VelocityRead,
        p + int2(1, 0),
        width,
        height).xy;
    float2 bottom = LoadClamped(
        _VelocityRead,
        p + int2(0, -1),
        width,
        height).xy;
    float2 top = LoadClamped(
        _VelocityRead,
        p + int2(0, 1),
        width,
        height).xy;

    float curl = 0.5 *
        ((right.y - left.y) -
         (top.x - bottom.x));
    _CurlWrite[dispatchId.xy] = float4(curl, 0.0, 0.0, 0.0);
}

[numthreads(8, 8, 1)]
void ApplyVorticity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _VelocityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    int2 p = int2(dispatchId.xy);
    float2 uv = GridUV(dispatchId.xy, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _VelocityWrite[dispatchId.xy] = 0.0;
        return;
    }

    float curlCenter = LoadClamped(
        _CurlRead,
        p,
        width,
        height).x;
    float curlLeft = abs(LoadClamped(
        _CurlRead,
        p + int2(-1, 0),
        width,
        height).x);
    float curlRight = abs(LoadClamped(
        _CurlRead,
        p + int2(1, 0),
        width,
        height).x);
    float curlBottom = abs(LoadClamped(
        _CurlRead,
        p + int2(0, -1),
        width,
        height).x);
    float curlTop = abs(LoadClamped(
        _CurlRead,
        p + int2(0, 1),
        width,
        height).x);

    float2 gradient = 0.5 * float2(
        curlRight - curlLeft,
        curlTop - curlBottom);
    float gradientLength = max(length(gradient), 1e-5);
    float2 normal = gradient / gradientLength;
    float2 confinement =
        float2(normal.y, -normal.x) * curlCenter;

    float2 velocity = _VelocityRead.Load(
        int3(dispatchId.xy, 0)).xy;
    velocity += confinement *
        _VorticityStrength * _DeltaTime;
    _VelocityWrite[dispatchId.xy] = float4(
        velocity,
        0.0,
        0.0);
}

[numthreads(8, 8, 1)]
void ComputeDivergence(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _DivergenceWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    int2 p = int2(dispatchId.xy);
    float2 uv = GridUV(dispatchId.xy, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _DivergenceWrite[dispatchId.xy] = 0.0;
        return;
    }

    float2 left = LoadClamped(
        _VelocityRead,
        p + int2(-1, 0),
        width,
        height).xy;
    float2 right = LoadClamped(
        _VelocityRead,
        p + int2(1, 0),
        width,
        height).xy;
    float2 bottom = LoadClamped(
        _VelocityRead,
        p + int2(0, -1),
        width,
        height).xy;
    float2 top = LoadClamped(
        _VelocityRead,
        p + int2(0, 1),
        width,
        height).xy;

    float divergence = 0.5 *
        ((right.x - left.x) +
         (top.y - bottom.y));
    _DivergenceWrite[dispatchId.xy] = float4(
        divergence,
        0.0,
        0.0,
        0.0);
}

[numthreads(8, 8, 1)]
void JacobiPressure(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _PressureWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    int2 p = int2(dispatchId.xy);
    float2 uv = GridUV(dispatchId.xy, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _PressureWrite[dispatchId.xy] = 0.0;
        return;
    }

    float center = LoadClamped(
        _PressureRead,
        p,
        width,
        height).x;
    float left = LoadClamped(
        _PressureRead,
        p + int2(-1, 0),
        width,
        height).x;
    float right = LoadClamped(
        _PressureRead,
        p + int2(1, 0),
        width,
        height).x;
    float bottom = LoadClamped(
        _PressureRead,
        p + int2(0, -1),
        width,
        height).x;
    float top = LoadClamped(
        _PressureRead,
        p + int2(0, 1),
        width,
        height).x;

    float2 texel = 1.0 / float2(width, height);
    if (ObstacleAt(uv - float2(texel.x, 0.0)) > 0.5) left = center;
    if (ObstacleAt(uv + float2(texel.x, 0.0)) > 0.5) right = center;
    if (ObstacleAt(uv - float2(0.0, texel.y)) > 0.5) bottom = center;
    if (ObstacleAt(uv + float2(0.0, texel.y)) > 0.5) top = center;

    float divergence = _DivergenceRead.Load(
        int3(dispatchId.xy, 0)).x;
    float pressure =
        (left + right + bottom + top - divergence) * 0.25;
    _PressureWrite[dispatchId.xy] = float4(
        pressure,
        0.0,
        0.0,
        0.0);
}

[numthreads(8, 8, 1)]
void ProjectVelocity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _VelocityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    int2 p = int2(dispatchId.xy);
    float2 uv = GridUV(dispatchId.xy, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _VelocityWrite[dispatchId.xy] = 0.0;
        return;
    }

    float center = LoadClamped(
        _PressureRead,
        p,
        width,
        height).x;
    float left = LoadClamped(
        _PressureRead,
        p + int2(-1, 0),
        width,
        height).x;
    float right = LoadClamped(
        _PressureRead,
        p + int2(1, 0),
        width,
        height).x;
    float bottom = LoadClamped(
        _PressureRead,
        p + int2(0, -1),
        width,
        height).x;
    float top = LoadClamped(
        _PressureRead,
        p + int2(0, 1),
        width,
        height).x;

    float2 texel = 1.0 / float2(width, height);
    if (ObstacleAt(uv - float2(texel.x, 0.0)) > 0.5) left = center;
    if (ObstacleAt(uv + float2(texel.x, 0.0)) > 0.5) right = center;
    if (ObstacleAt(uv - float2(0.0, texel.y)) > 0.5) bottom = center;
    if (ObstacleAt(uv + float2(0.0, texel.y)) > 0.5) top = center;

    float2 velocity = _VelocityRead.Load(
        int3(dispatchId.xy, 0)).xy;
    velocity -= 0.5 * float2(
        right - left,
        top - bottom);

    if (velocity.x < 0.0 &&
        ObstacleAt(uv - float2(texel.x, 0.0)) > 0.5)
        velocity.x = 0.0;
    if (velocity.x > 0.0 &&
        ObstacleAt(uv + float2(texel.x, 0.0)) > 0.5)
        velocity.x = 0.0;
    if (velocity.y < 0.0 &&
        ObstacleAt(uv - float2(0.0, texel.y)) > 0.5)
        velocity.y = 0.0;
    if (velocity.y > 0.0 &&
        ObstacleAt(uv + float2(0.0, texel.y)) > 0.5)
        velocity.y = 0.0;

    _VelocityWrite[dispatchId.xy] = float4(
        velocity,
        0.0,
        0.0);
}

[numthreads(8, 8, 1)]
void ApplyBlastVelocity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _VelocityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    float2 uv = GridUV(id, width, height);
    if (ObstacleAt(uv) > 0.5)
    {
        _VelocityWrite[id] = 0.0;
        return;
    }

    float2 velocity = _VelocityRead.Load(int3(id, 0)).xy;
    float2 worldPx = uv * _RoomSizePx.xy;

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        if (i >= _BlastCount)
            break;

        float4 blast = _BlastPosRadii[i];
        float4 parameters = _BlastParams[i];
        float2 blastPx = blast.xy * _RoomSizePx.xy;
        float2 deltaPx = worldPx - blastPx;
        float distancePx = length(deltaPx);
        if (distancePx <= 0.5 || distancePx >= blast.w)
            continue;

        float terrain = BlastTerrainTransmission(blastPx, worldPx, 0.0);
        if (terrain <= 0.0)
            continue;

        float2 direction = deltaPx / distancePx;
        float shock = 1.0 - smoothstep(
            blast.z * 0.12,
            blast.w,
            distancePx);
        shock = pow(saturate(shock), 0.72);

        float2 impulseUvPerSecond =
            direction * parameters.x /
            max(_RoomSizePx.xy, float2(1.0, 1.0));
        velocity += impulseUvPerSecond * shock * terrain;
    }

    float2 texel = 1.0 / float2(width, height);
    if (velocity.x < 0.0 &&
        ObstacleAt(uv - float2(texel.x, 0.0)) > 0.5)
        velocity.x = 0.0;
    if (velocity.x > 0.0 &&
        ObstacleAt(uv + float2(texel.x, 0.0)) > 0.5)
        velocity.x = 0.0;
    if (velocity.y < 0.0 &&
        ObstacleAt(uv - float2(0.0, texel.y)) > 0.5)
        velocity.y = 0.0;
    if (velocity.y > 0.0 &&
        ObstacleAt(uv + float2(0.0, texel.y)) > 0.5)
        velocity.y = 0.0;

    _VelocityWrite[id] = float4(velocity, 0.0, 0.0);
}

[numthreads(8, 8, 1)]
void AdvectDensity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _DensityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    int2 p = int2(id);
    float2 uv = GridUV(id, width, height);
    float clearDecay = exp(-max(0.0, _BlastClearDecay) * _DeltaTime);
    float4 localState = _DensityRead.Load(int3(id, 0));

    float waveLife = max(0.0, localState.a - _DeltaTime);
    float waveAge = BlastWaveLifetime - waveLife;
    float waveHit = 0.0;
    if (waveLife > 0.0001)
    {
        float waveDistancePx = localState.b * BlastWaveDistanceScale;
        float waveRadiusPx = BlastWaveRadiusPx(waveAge);
        waveHit = 1.0 - smoothstep(
            waveRadiusPx - 14.0,
            waveRadiusPx + 10.0,
            waveDistancePx);
        waveHit = saturate(waveHit);
    }

    float localDecayedClear = saturate(localState.g * clearDecay);
    bool solid = ObstacleAt(uv) > 0.5;

    if (solid)
    {
        float surfaceClear = DiffuseBlastClear(
            p,
            width,
            height,
            localDecayedClear,
            2.40);
        surfaceClear = max(surfaceClear, waveHit * 0.995);

        _DensityWrite[id] = float4(
            0.0,
            saturate(surfaceClear),
            waveLife > 0.0001 ? localState.b : 0.0,
            waveLife);
        return;
    }

    float2 velocity = _VelocityRead.Load(int3(id, 0)).xy;
    float2 backtrace = clamp(
        uv - velocity * _DeltaTime,
        0.0,
        1.0);
    if (ObstacleAt(backtrace) > 0.5)
        backtrace = uv;

    float4 state = _DensityRead.SampleLevel(
        LinearClampSampler,
        backtrace,
        0);
    float advectedBlastClear = saturate(state.g * clearDecay);

    advectedBlastClear = DiffuseBlastClear(
        p,
        width,
        height,
        advectedBlastClear,
        0.34);
    advectedBlastClear = max(
        advectedBlastClear,
        waveHit * 0.995);

    float waveProtection = smoothstep(0.0, 0.18, waveLife);
    float incomingDensityScale = lerp(1.0, 0.08, waveProtection);
    float density =
        state.r * _DensityDissipation * incomingDensityScale;

    density *= lerp(1.0, 0.055, waveHit);

    _DensityWrite[id] = float4(
        saturate(density),
        saturate(advectedBlastClear),
        waveLife > 0.0001 ? localState.b : 0.0,
        waveLife);
}

[numthreads(8, 8, 1)]
void MaintainDensity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _DensityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    float2 uv = GridUV(id, width, height);
    float4 state = _DensityRead.Load(int3(id, 0));
    float blastClear = saturate(state.g);
    float waveProtection = smoothstep(0.0, 0.18, state.a);

    if (ObstacleAt(uv) > 0.5)
    {
        _DensityWrite[id] = float4(
            0.0,
            blastClear,
            state.b,
            state.a);
        return;
    }

    float density = state.r;
    float shape = TargetShape(uv, _SimulationTime);

    float interiorTarget =
        _TargetDensity * lerp(0.54, 1.05, shape);
    float interiorRelax =
        1.0 - exp(-_DensityRelaxation * _DeltaTime);
    interiorRelax *= lerp(1.0, 0.02, waveProtection);
    density = lerp(
        density,
        interiorTarget,
        interiorRelax);

    float sourceDistance =
        _WindVelocity.x >= 0.0 ? uv.x : (1.0 - uv.x);
    float outletDistance = 1.0 - sourceDistance;
    float inlet = exp(-sourceDistance * 20.0);
    float outlet = exp(-outletDistance * 18.0);

    float inletPulse = saturate(
        0.62 +
        0.24 * sin((uv.y * 2.7 + _SimulationTime * 0.009) * TwoPi) +
        0.14 * sin((uv.y * -6.1 + _SimulationTime * 0.004 + 0.37) * TwoPi));
    float inletTarget =
        _TargetDensity * lerp(0.58, 1.34, inletPulse);
    float inletMix = inlet *
        (1.0 - exp(-2.6 * _DeltaTime));
    inletMix *= lerp(1.0, 0.04, waveProtection);
    density = lerp(
        density,
        inletTarget,
        saturate(inletMix));

    density *= exp(-0.42 * outlet * _DeltaTime);

    float wallDistance = WallDistance01(uv);
    density += pow(
        saturate(1.0 - wallDistance),
        2.35) * 0.052 * _DeltaTime *
        lerp(1.0, 0.02, waveProtection);

    float2 worldPx = uv * _RoomSizePx.xy;
    [unroll]
    for (int i = 0; i < 4; i++)
    {
        if (i >= _ImpulseCount)
            break;

        float4 impulse = _ImpulsePosRadius[i];
        float2 impulsePx = impulse.xy * _RoomSizePx.xy;
        float falloff = SmoothFalloff(
            distance(worldPx, impulsePx),
            impulse.z) * impulse.w;
        density *= 1.0 - falloff * 0.28;
    }

    _DensityWrite[id] = float4(
        saturate(density),
        blastClear,
        state.b,
        state.a);
}

[numthreads(8, 8, 1)]
void ApplyBlastDensity(uint3 dispatchId : SV_DispatchThreadID)
{
    uint width;
    uint height;
    _DensityWrite.GetDimensions(width, height);
    if (dispatchId.x >= width || dispatchId.y >= height)
        return;

    uint2 id = dispatchId.xy;
    float2 uv = GridUV(id, width, height);
    float receiverSolid = step(0.5, ObstacleAt(uv));
    float2 worldPx = uv * _RoomSizePx.xy;
    float4 state = _DensityRead.Load(int3(id, 0));
    float density = state.r;
    float blastClear = state.g;
    float waveDistance = state.b;
    float waveLife = state.a;

    [unroll]
    for (int i = 0; i < 4; i++)
    {
        if (i >= _BlastCount)
            break;

        float4 blast = _BlastPosRadii[i];
        float4 parameters = _BlastParams[i];
        float2 blastPx = blast.xy * _RoomSizePx.xy;
        float2 deltaPx = worldPx - blastPx;
        float distancePx = length(deltaPx);
        if (distancePx >= blast.w * 1.18)
            continue;

        float radiusScale = BlastShapeRadiusScale(deltaPx, blast.xy);
        float shapedDistancePx = distancePx / max(0.82, radiusScale);

        if (shapedDistancePx < blast.z)
        {
            float encodedDistance = saturate(
                shapedDistancePx / BlastWaveDistanceScale);
            if (waveLife <= 0.0001 || encodedDistance < waveDistance)
            {
                waveDistance = encodedDistance;
                waveLife = BlastWaveLifetime;
            }

            float initialHit = 1.0 - smoothstep(
                8.0,
                24.0,
                shapedDistancePx);
            blastClear = max(
                blastClear,
                initialHit * parameters.w);
        }

        float terrain = BlastTerrainTransmission(
            blastPx,
            worldPx,
            receiverSolid);
        if (terrain <= 0.0)
            continue;

        float initialPhysicalHit = 1.0 - smoothstep(
            8.0,
            24.0,
            shapedDistancePx);
        if (receiverSolid < 0.5)
        {
            density *=
                1.0 - initialPhysicalHit * parameters.y * terrain;
        }

        float ringInner = smoothstep(
            blast.z * 0.72,
            blast.z * 1.04,
            shapedDistancePx);
        float ringOuter = 1.0 - smoothstep(
            blast.z * 1.04,
            blast.w,
            shapedDistancePx);
        float ring = saturate(ringInner * ringOuter);
        density += ring * parameters.z * _TargetDensity * terrain;
    }

    if (receiverSolid > 0.5)
        density = 0.0;

    _DensityWrite[id] = float4(
        saturate(density),
        saturate(blastClear),
        waveDistance,
        waveLife);
}