#pragma kernel BakeV4

RWTexture2D<float4> _Atlas;
float4 _Motif, _Pattern, _Material, _Eye, _NoiseSeed;

float cell(int2 p)
{
    uint n = (uint)p.x * 374761393u + (uint)p.y * 668265263u;
    n = (n ^ (n >> 13)) * 1274126177u;
    return ((n ^ (n >> 16)) & 65535u) / 65535.0;
}
float noise(float2 p)
{
    int2 q = (int2)floor(p); float2 f = frac(p); f = f*f*(3-2*f);
    return lerp(lerp(cell(q),cell(q+int2(1,0)),f.x),lerp(cell(q+int2(0,1)),cell(q+1),f.x),f.y);
}
float plateSeam(float2 p)
{
    int2 q=(int2)floor(p); float nearest=100, second=100;
    for (int cy=-1;cy<=1;cy++) for (int cx=-1;cx<=1;cx++)
    {
        int2 tile=q+int2(cx,cy);
        float2 d=tile+.2+float2(cell(tile),cell(tile+int2(37,-19)))*.6-p;
        float distance=dot(d,d);
        if(distance<nearest) { second=nearest; nearest=distance; } else second=min(second,distance);
    }
    return 1-smoothstep(.02,.16,sqrt(second)-sqrt(nearest));
}

// Surface atlas layout remains two 128px layers. Layer 0 = albedo.rgb + height.a.
// Layer 1 = AO.r + roughness.g + anatomical mask.b + emission.a.
[numthreads(8,8,1)]
void BakeV4(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= 896 || id.y >= 128) return;
    uint kind = id.x / 128;
    float2 uv = float2(id.x % 128, id.y) / 127.0;
    float u=uv.x, v=uv.y, wing=abs(u*2-1), lateral=v*2-1;
    float mutation = u<.5 ? _NoiseSeed.z : _NoiseSeed.w;
    float n=noise(float2(wing*5+_NoiseSeed.x,v*6+mutation*_Pattern.w));
    float meso=noise(float2(u*17+_NoiseSeed.x,v*12+_NoiseSeed.y));
    float micro=noise(float2(u*83+mutation,v*91+_NoiseSeed.y));
    float plate=plateSeam(float2((kind==0?wing:u)*12+_NoiseSeed.x,v*(kind==0?8:3)+_NoiseSeed.y+mutation*_Pattern.w));
    float band=pow(.5+.5*cos(wing*(_Motif.x+15)*3.141593+(1-v)*(6+wing*(8+5*_Pattern.z))+(1-v)*(1-v)*7*wing+(n-.5)*_Motif.w*3+_Pattern.y),_Motif.y+1);
    band *= .76+.24*smoothstep(_Pattern.x,_Pattern.x+.18,meso);
    float endCollar=pow(abs(u*2-1),12), ridge=abs(sin((u*_Material.y+meso*.12)*6.283185));
    float height=.45+(meso-.5)*.12+(micro-.5)*.025;
    float ao=.8, rough=_Material.x, emission=0, anatomy=0;
    float3 color=0;

    if (kind==0)
    {
        float wingMask=smoothstep(.30,.69,wing);
        color=lerp(float3(.021,.018,.048),float3(.24,.27,.33),wingMask);
        color=lerp(color,float3(.48,.065,.17+_Material.w),band*_Motif.z*wingMask*(.55+v*.45));
        float crown=smoothstep(.65,.95,v)*(1-wingMask);
        color=lerp(color,float3(.24,.070,.125),crown*.75);
        height+=band*.08;
        ao=lerp(.4,.95,smoothstep(0,1,v*3));
        rough=lerp(.94,.68,wing);
        anatomy=band*wingMask;
    }
    else if (kind==4)
    {
        float face=smoothstep(-.65,.48,lateral);
        float pigment=noise(float2(u*5+_NoiseSeed.x,v*2+_NoiseSeed.y));
        float3 front=lerp(float3(.49,.067,.18),float3(.30,.060,.19),pigment*.30);
        color=lerp(float3(.070,.048,.125),front,face)*(.82+.30*_Material.z);
        color*=.94+.09*n;
        float coolEdge=1-smoothstep(-.99,-.80,lateral);
        color=lerp(color,float3(.10,.17,.23),coolEdge*.38);
        anatomy=smoothstep(.72,.98,abs(lateral));
        ao=.97-.10*endCollar;
        rough=.72;
        height=.48+sqrt(max(0,1-lateral*lateral))*.075+(n-.5)*.018+(micro-.5)*.006;
    }
    else if (kind==5)
    {
        color=float3(.8,.018+_Eye.y*.025,.035);
        emission=.22+(1-smoothstep(0,_Eye.x,length(uv-.5)))*.48;
        rough=.15; ao=1; height=.5;
    }
    else if (kind==3)
    {
        float3 blueGrey=lerp(float3(.105,.155,.205+_Material.w),float3(.205,.270,.315),.32+meso*.22);
        float3 innerPlateColor=float3(.090,.035,.105);
        float innerPlate=smoothstep(0,1,saturate((-lateral-.02)/.72));
        float heelPlate=pow(saturate(1-abs(u-.57)/.22),2)*lerp(.35,.72,innerPlate);
        color=lerp(blueGrey,innerPlateColor,saturate(innerPlate*.78+heelPlate*.22));
        float sole=smoothstep(.76,.98,u);
        float ankleBand=pow(saturate(1-abs(u-.18)/.07),2);
        color*=lerp(1,.72,sole*.55);
        color=lerp(color,float3(.07,.055,.105),ankleBand*.32);
        ao=.76-sole*.28-ankleBand*.10;
        rough=lerp(.68,.94,sole);
        float growthBand=pow(max(0,cos((u*2.6+.3)*3.141593)),8)*saturate((u-.25)/.6);
        color=lerp(color,float3(.075,.025,.115),growthBand*.55);
        height+=heelPlate*.045;
        anatomy=sole;
    }
    else if (kind==2)
    {
        float lip=1-smoothstep(.04,.30,u);
        color=lerp(float3(.022,.014,.038),float3(.12,.105,.19),lip*.70);
        color*=.94+meso*.08;
        ao=.72;
        rough=.86;
        height=.48+lip*.018;
        anatomy=1-lip;
    }
    else if (kind==6)
    {
        color=float3(.075,.10,.15);
        ao=.65;
        rough=.76;
    }
    else
    {
        color=lerp(float3(.20,.32,.39+_Material.w),float3(.29,.43,.50),meso*.15);
        ao=.96-endCollar*.16;
        rough=.52;
        color*=lerp(.62,1.16,smoothstep(-.25,.15,lateral));
        height+=(1-abs(lateral))*.035;
        anatomy=saturate(plate*.65+endCollar*.20);
    }

    if(kind!=5)
    {
        height-=plate*(kind==0?.025:.006);
        ao*=1-plate*(kind==0?.10:.025);
        rough=saturate(rough+(micro-.5)*.08);
    }

    _Atlas[id.xy]=float4(color,saturate(height));
    _Atlas[id.xy+uint2(0,128)]=float4(saturate(ao),saturate(rough),saturate(anatomy),emission);
}
